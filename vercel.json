{
  "version": 2,
  "builds": [
    { "src": "api/chat.js", "use": "@vercel/node" },
    { "src": "api/debug.js", "use": "@vercel/node" },
    { "src": "api/enviar-resumo.js", "use": "@vercel/node" },
    { "src": "api/manter-ativo.js", "use": "@vercel/node" },
    { "src": "*.html",      "use": "@vercel/static" },
    { "src": "*.js",        "use": "@vercel/static", "config": { "excludeFiles": "api/**" } },
    { "src": "styles/**",   "use": "@vercel/static" },
    { "src": "scripts/**",  "use": "@vercel/static" },
    { "src": "bio-imgs/**", "use": "@vercel/static" },
    { "src": "geo-imgs/**",  "use": "@vercel/static" },
    { "src": "hist-imgs/**", "use": "@vercel/static" },
    { "src": "hist-videos/**", "use": "@vercel/static" },
    { "src": "filo-videos/**", "use": "@vercel/static" },
    { "src": "qui-imgs/**",  "use": "@vercel/static" },
    { "src": "socio-imgs/**", "use": "@vercel/static" },
    { "src": "*.png",       "use": "@vercel/static" },
    { "src": "*.svg",       "use": "@vercel/static" },
    { "src": "*.webmanifest", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/debug", "dest": "/api/debug.js" },
    { "src": "/api/enviar-resumo", "dest": "/api/enviar-resumo.js" },
    { "src": "/api/manter-ativo", "dest": "/api/manter-ativo.js" },
    { "src": "/sw.js", "headers": { "cache-control": "no-cache" }, "continue": true },
    { "src": "/manifest.webmanifest", "headers": { "content-type": "application/manifest+json" }, "continue": true },
    { "src": "/",         "dest": "/index.html" },
    { "src": "/enviar",   "dest": "/enviar.html" },
    { "handle": "filesystem" },
    { "src": "/([a-z0-9-]+)/?", "dest": "/$1.html" }
  ],
  "crons": [
    { "path": "/api/manter-ativo", "schedule": "17 9 * * *" }
  ]
}
